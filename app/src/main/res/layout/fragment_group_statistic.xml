<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_group_statistic"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <de.timseidel.doppelkopf.ui.MemberListHeaderView
        android:id="@+id/header_statistic_member_select"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:layout_marginTop="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ListView
        android:id="@+id/lv_group_statistic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_statistic_member_select"
        tools:listitem="@layout/view_simple_text_statistic" />

    <LinearLayout
        android:id="@+id/layout_group_statistic_state_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CCFFFFFF"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/lv_group_statistic"
        app:layout_constraintEnd_toEndOf="@id/lv_group_statistic"
        app:layout_constraintStart_toStartOf="@id/lv_group_statistic"
        app:layout_constraintTop_toTopOf="@id/lv_group_statistic">

        <ProgressBar
            android:id="@+id/pb_group_statistic_loading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="260dp"
            android:layout_height="10dp"
            android:layout_marginBottom="12dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:progressTint="@color/primary" />

        <TextView
            android:id="@+id/tv_group_statistic_state_message"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/group_statistic_loading_sessions"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textSize="15sp"
            tools:text="Lade Sessions fuer Statistiken..." />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
